{
  "openapi": "3.1.0",
  "info": {
    "title": "ModelRAG API v2",
    "version": "1.0.0",
    "description": "Typed, bearer-authenticated API for knowledge bases, RAG, conversations, memory, tools and evaluation."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "bearerAuth": [] }],
  "tags": [
    { "name": "assistant" },
    { "name": "conversations" },
    { "name": "memory" },
    { "name": "documents" },
    { "name": "models" },
    { "name": "tools" },
    { "name": "evaluations" },
    { "name": "authentication" },
    { "name": "administration" },
    { "name": "monitoring" }
  ],
  "paths": {
    "/api/v2/auth/login": {
      "post": { "tags": ["authentication"], "operationId": "login", "security": [], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["username", "password"], "properties": { "username": { "type": "string" }, "password": { "type": "string", "writeOnly": true } } } } }, "responses": { "200": { "$ref": "#/components/responses/UntypedApiResponse" }, "403": { "$ref": "#/components/responses/Forbidden" } } } }
    },
    "/api/v2/auth/register": {
      "post": { "tags": ["authentication"], "operationId": "register", "security": [], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["username", "password"], "properties": { "username": { "type": "string" }, "password": { "type": "string", "minLength": 12, "writeOnly": true }, "displayName": { "type": ["string", "null"] } } } } }, "responses": { "200": { "$ref": "#/components/responses/UntypedApiResponse" }, "400": { "$ref": "#/components/responses/ValidationError" } } } }
    },
    "/api/v2/auth/refresh": {
      "post": { "tags": ["authentication"], "operationId": "refreshAuthentication", "security": [], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["refreshToken"], "properties": { "refreshToken": { "type": "string", "writeOnly": true } } } } }, "responses": { "200": { "$ref": "#/components/responses/UntypedApiResponse" }, "403": { "$ref": "#/components/responses/Forbidden" } } } }
    },
    "/api/v2/auth/logout": {
      "post": { "tags": ["authentication"], "operationId": "logout", "security": [], "requestBody": { "required": false, "content": { "application/json": { "schema": { "type": "object", "properties": { "refreshToken": { "type": ["string", "null"], "writeOnly": true } } } } }, "responses": { "200": { "$ref": "#/components/responses/EmptySuccess" } } } }
    },
    "/api/v2/auth/me": {
      "get": { "tags": ["authentication"], "operationId": "getCurrentUser", "responses": { "200": { "$ref": "#/components/responses/UntypedApiResponse" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/api/v2/admin/security/users": {
      "get": { "tags": ["administration"], "operationId": "listUsers", "responses": { "200": { "$ref": "#/components/responses/UntypedApiResponse" }, "403": { "$ref": "#/components/responses/Forbidden" } } },
      "post": { "tags": ["administration"], "operationId": "upsertUser", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } }, "responses": { "200": { "$ref": "#/components/responses/UntypedApiResponse" }, "403": { "$ref": "#/components/responses/Forbidden" } } }
    },
    "/api/v2/admin/security/users/{userId}/datasets/{datasetId}": {
      "post": { "tags": ["administration"], "operationId": "grantUserDataset", "parameters": [{ "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }, { "$ref": "#/components/parameters/DatasetId" }], "responses": { "200": { "$ref": "#/components/responses/UntypedApiResponse" } } },
      "delete": { "tags": ["administration"], "operationId": "revokeUserDataset", "parameters": [{ "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }, { "$ref": "#/components/parameters/DatasetId" }], "responses": { "200": { "$ref": "#/components/responses/EmptySuccess" } } }
    },
    "/api/v2/admin/qa-audits": {
      "get": { "tags": ["administration"], "operationId": "listQaAudits", "responses": { "200": { "$ref": "#/components/responses/UntypedApiResponse" } } }
    },
    "/api/v2/admin/feedbacks": {
      "get": { "tags": ["administration"], "operationId": "listQaFeedback", "responses": { "200": { "$ref": "#/components/responses/UntypedApiResponse" } } }
    },
    "/api/v2/admin/approvals": {
      "get": { "tags": ["administration"], "operationId": "listAllApprovals", "responses": { "200": { "$ref": "#/components/responses/ApprovalList" } } }
    },
    "/api/v2/admin/agent-steps": {
      "get": { "tags": ["administration"], "operationId": "listAgentSteps", "responses": { "200": { "$ref": "#/components/responses/UntypedApiResponse" } } }
    },
    "/api/v2/admin/agent-steps/{executionId}": {
      "get": { "tags": ["administration"], "operationId": "listAgentExecutionSteps", "parameters": [{ "$ref": "#/components/parameters/ExecutionId" }], "responses": { "200": { "$ref": "#/components/responses/UntypedApiResponse" } } }
    },
    "/api/v2/admin/retrieval-traces/{traceId}/replay": {
      "get": { "tags": ["administration"], "operationId": "replayAdminTrace", "parameters": [{ "$ref": "#/components/parameters/TraceId" }], "responses": { "200": { "$ref": "#/components/responses/TraceReplay" } } }
    },
    "/api/v2/monitor/overview": {
      "get": { "tags": ["monitoring"], "operationId": "getUsageOverview", "parameters": [{ "$ref": "#/components/parameters/DatasetIdQuery" }], "responses": { "200": { "$ref": "#/components/responses/UntypedApiResponse" } } }
    },
    "/api/v2/monitor/model-health": {
      "get": { "tags": ["monitoring"], "operationId": "listModelHealth", "responses": { "200": { "$ref": "#/components/responses/UntypedApiResponse" } } }
    },
    "/api/v2/monitor/model-candidates": {
      "put": { "tags": ["monitoring"], "operationId": "saveModelCandidate", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } }, "responses": { "200": { "$ref": "#/components/responses/UntypedApiResponse" } } }
    },
    "/api/v2/qa/feedback": {
      "post": { "tags": ["assistant"], "operationId": "submitQaFeedback", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } }, "responses": { "200": { "$ref": "#/components/responses/UntypedApiResponse" } } }
    },
    "/api/v2/qa/context-policy": {
      "get": { "tags": ["assistant"], "operationId": "getContextPolicy", "responses": { "200": { "$ref": "#/components/responses/UntypedApiResponse" } } }
    },
    "/api/v2/qa/ask": {
      "post": { "tags": ["assistant"], "operationId": "askQaCompatibility", "deprecated": true, "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } }, "responses": { "200": { "$ref": "#/components/responses/UntypedApiResponse" } } }
    },
    "/api/v2/qa/stream": {
      "get": { "tags": ["assistant"], "operationId": "streamQaCompatibility", "deprecated": true, "parameters": [{ "name": "q", "in": "query", "required": true, "schema": { "type": "string" } }, { "name": "kbId", "in": "query", "required": true, "schema": { "type": "integer", "format": "int64" } }], "responses": { "200": { "$ref": "#/components/responses/SseStream" } } }
    },
    "/api/v2/qa/traces": {
      "get": { "tags": ["administration"], "operationId": "listRetrievalTraces", "responses": { "200": { "$ref": "#/components/responses/UntypedApiResponse" } } }
    },
    "/api/v2/assistant/ask": {
      "post": {
        "tags": ["assistant"],
        "operationId": "askAssistant",
        "requestBody": { "$ref": "#/components/requestBodies/AssistantAsk" },
        "responses": { "200": { "$ref": "#/components/responses/AssistantAnswer" }, "400": { "$ref": "#/components/responses/ValidationError" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "503": { "$ref": "#/components/responses/DependencyUnavailable" } }
      }
    },
    "/api/v2/assistant/streams": {
      "post": {
        "tags": ["assistant"],
        "operationId": "streamAssistant",
        "requestBody": { "$ref": "#/components/requestBodies/AssistantAsk" },
        "responses": { "200": { "$ref": "#/components/responses/SseStream" }, "400": { "$ref": "#/components/responses/ValidationError" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/api/v2/assistant/streams/{executionId}": {
      "get": {
        "tags": ["assistant"],
        "operationId": "streamAgentExecution",
        "parameters": [{ "$ref": "#/components/parameters/ExecutionId" }],
        "responses": { "200": { "$ref": "#/components/responses/SseStream" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/api/v2/assistant/executions/{executionId}": {
      "delete": {
        "tags": ["assistant"],
        "operationId": "cancelAssistantExecution",
        "parameters": [{ "$ref": "#/components/parameters/ExecutionId" }],
        "responses": { "200": { "$ref": "#/components/responses/EmptySuccess" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/api/v2/assistant/auto": {
      "post": {
        "tags": ["assistant"],
        "operationId": "autoAssistant",
        "requestBody": { "$ref": "#/components/requestBodies/AutoQuestion" },
        "responses": { "200": { "$ref": "#/components/responses/AutoAnswer" }, "400": { "$ref": "#/components/responses/ValidationError" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/api/v2/assistant/auto/stream": {
      "post": {
        "tags": ["assistant"],
        "operationId": "streamAutoAssistant",
        "requestBody": { "$ref": "#/components/requestBodies/AutoQuestion" },
        "responses": { "200": { "$ref": "#/components/responses/SseStream" }, "400": { "$ref": "#/components/responses/ValidationError" } }
      }
    },
    "/api/v2/conversations": {
      "get": {
        "tags": ["conversations"],
        "operationId": "listConversations",
        "responses": { "200": { "$ref": "#/components/responses/ConversationList" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      },
      "post": {
        "tags": ["conversations"],
        "operationId": "createConversation",
        "requestBody": { "$ref": "#/components/requestBodies/ConversationCreate" },
        "responses": { "200": { "$ref": "#/components/responses/Conversation" }, "400": { "$ref": "#/components/responses/ValidationError" } }
      }
    },
    "/api/v2/conversations/{conversationId}": {
      "get": {
        "tags": ["conversations"],
        "operationId": "getConversation",
        "parameters": [{ "$ref": "#/components/parameters/ConversationId" }],
        "responses": { "200": { "$ref": "#/components/responses/Conversation" }, "404": { "$ref": "#/components/responses/NotFound" } }
      },
      "delete": {
        "tags": ["conversations"],
        "operationId": "deleteConversation",
        "parameters": [{ "$ref": "#/components/parameters/ConversationId" }],
        "responses": { "200": { "$ref": "#/components/responses/EmptySuccess" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/api/v2/conversations/{conversationId}/archive": {
      "post": {
        "tags": ["conversations"],
        "operationId": "archiveConversationExplicitly",
        "parameters": [{ "$ref": "#/components/parameters/ConversationId" }],
        "responses": { "200": { "$ref": "#/components/responses/EmptySuccess" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/api/v2/conversations/{conversationId}/messages": {
      "get": {
        "tags": ["conversations"],
        "operationId": "listConversationMessages",
        "parameters": [{ "$ref": "#/components/parameters/ConversationId" }],
        "responses": { "200": { "$ref": "#/components/responses/MessageList" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/api/v2/conversations/{conversationId}/export": {
      "get": {
        "tags": ["conversations"],
        "operationId": "exportConversation",
        "parameters": [{ "$ref": "#/components/parameters/ConversationId" }],
        "responses": { "200": { "$ref": "#/components/responses/MessageList" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/api/v2/memories": {
      "get": {
        "tags": ["memory"],
        "operationId": "listMemories",
        "parameters": [{ "$ref": "#/components/parameters/DatasetIdOptional" }, { "$ref": "#/components/parameters/MemoryQuery" }],
        "responses": { "200": { "$ref": "#/components/responses/MemoryList" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      },
      "delete": {
        "tags": ["memory"],
        "operationId": "clearMemories",
        "parameters": [{ "$ref": "#/components/parameters/DatasetIdOptional" }],
        "responses": { "200": { "$ref": "#/components/responses/EmptySuccess" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/api/v2/memories/remember": {
      "post": {
        "tags": ["memory"],
        "operationId": "rememberMemory",
        "requestBody": { "$ref": "#/components/requestBodies/MemoryRemember" },
        "responses": { "200": { "$ref": "#/components/responses/Memory" }, "400": { "$ref": "#/components/responses/ValidationError" } }
      }
    },
    "/api/v2/memories/{memoryId}": {
      "put": {
        "tags": ["memory"],
        "operationId": "updateMemory",
        "parameters": [{ "$ref": "#/components/parameters/MemoryId" }],
        "requestBody": { "$ref": "#/components/requestBodies/MemoryRemember" },
        "responses": { "200": { "$ref": "#/components/responses/Memory" }, "404": { "$ref": "#/components/responses/NotFound" } }
      },
      "delete": {
        "tags": ["memory"],
        "operationId": "deleteMemory",
        "parameters": [{ "$ref": "#/components/parameters/MemoryId" }],
        "responses": { "200": { "$ref": "#/components/responses/EmptySuccess" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/api/v2/memories/{memoryId}/confirm": {
      "post": { "tags": ["memory"], "operationId": "confirmMemory", "parameters": [{ "$ref": "#/components/parameters/MemoryId" }], "responses": { "200": { "$ref": "#/components/responses/Memory" } } }
    },
    "/api/v2/memories/{memoryId}/reject": {
      "post": { "tags": ["memory"], "operationId": "rejectMemory", "parameters": [{ "$ref": "#/components/parameters/MemoryId" }], "responses": { "200": { "$ref": "#/components/responses/Memory" } } }
    },
    "/api/v2/memories/{memoryId}/pause": {
      "post": { "tags": ["memory"], "operationId": "pauseMemory", "parameters": [{ "$ref": "#/components/parameters/MemoryId" }], "responses": { "200": { "$ref": "#/components/responses/Memory" } } }
    },
    "/api/v2/memories/{memoryId}/resume": {
      "post": { "tags": ["memory"], "operationId": "resumeMemory", "parameters": [{ "$ref": "#/components/parameters/MemoryId" }], "responses": { "200": { "$ref": "#/components/responses/Memory" } } }
    },
    "/api/v2/memories/export": {
      "get": { "tags": ["memory"], "operationId": "exportMemories", "parameters": [{ "$ref": "#/components/parameters/DatasetIdOptional" }], "responses": { "200": { "$ref": "#/components/responses/MemoryList" } } }
    },
    "/api/v2/memory-settings": {
      "get": { "tags": ["memory"], "operationId": "getMemorySettings", "responses": { "200": { "$ref": "#/components/responses/MemorySettings" } } },
      "put": { "tags": ["memory"], "operationId": "updateMemorySettings", "requestBody": { "$ref": "#/components/requestBodies/MemorySettings" }, "responses": { "200": { "$ref": "#/components/responses/MemorySettings" }, "400": { "$ref": "#/components/responses/ValidationError" } } }
    },
    "/api/v2/datasets": {
      "get": { "tags": ["documents"], "operationId": "listDatasets", "responses": { "200": { "$ref": "#/components/responses/DatasetList" } } },
      "post": { "tags": ["documents"], "operationId": "createDataset", "requestBody": { "$ref": "#/components/requestBodies/DatasetMutation" }, "responses": { "200": { "$ref": "#/components/responses/Dataset" }, "400": { "$ref": "#/components/responses/ValidationError" } } }
    },
    "/api/v2/datasets/{datasetId}": {
      "get": { "tags": ["documents"], "operationId": "getDataset", "parameters": [{ "$ref": "#/components/parameters/DatasetId" }], "responses": { "200": { "$ref": "#/components/responses/Dataset" } } },
      "put": { "tags": ["documents"], "operationId": "updateDataset", "parameters": [{ "$ref": "#/components/parameters/DatasetId" }], "requestBody": { "$ref": "#/components/requestBodies/DatasetMutation" }, "responses": { "200": { "$ref": "#/components/responses/Dataset" } } },
      "delete": { "tags": ["documents"], "operationId": "deleteDataset", "parameters": [{ "$ref": "#/components/parameters/DatasetId" }], "responses": { "200": { "$ref": "#/components/responses/EmptySuccess" } } }
    },
    "/api/v2/datasets/{datasetId}/rebuild": {
      "post": { "tags": ["documents"], "operationId": "rebuildDatasetIndex", "parameters": [{ "$ref": "#/components/parameters/DatasetId" }], "responses": { "200": { "$ref": "#/components/responses/UntypedApiResponse" } } }
    },
    "/api/v2/datasets/{datasetId}/intents": {
      "get": { "tags": ["documents"], "operationId": "listDatasetIntents", "parameters": [{ "$ref": "#/components/parameters/DatasetId" }], "responses": { "200": { "$ref": "#/components/responses/UntypedApiResponse" } } },
      "post": { "tags": ["documents"], "operationId": "createDatasetIntent", "parameters": [{ "$ref": "#/components/parameters/DatasetId" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IntentNode" } } } }, "responses": { "200": { "$ref": "#/components/responses/UntypedApiResponse" } } }
    },
    "/api/v2/datasets/{datasetId}/intents/{intentId}": {
      "put": { "tags": ["documents"], "operationId": "updateDatasetIntent", "parameters": [{ "$ref": "#/components/parameters/DatasetId" }, { "$ref": "#/components/parameters/IntentId" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IntentNode" } } } }, "responses": { "200": { "$ref": "#/components/responses/UntypedApiResponse" } } },
      "delete": { "tags": ["documents"], "operationId": "deleteDatasetIntent", "parameters": [{ "$ref": "#/components/parameters/DatasetId" }, { "$ref": "#/components/parameters/IntentId" }], "responses": { "200": { "$ref": "#/components/responses/EmptySuccess" } } }
    },
    "/api/v2/datasets/{datasetId}/documents": {
      "get": {
        "tags": ["documents"],
        "operationId": "listDatasetDocuments",
        "parameters": [{ "$ref": "#/components/parameters/DatasetId" }],
        "responses": { "200": { "$ref": "#/components/responses/DocumentList" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" } }
      },
      "post": {
        "tags": ["documents"],
        "operationId": "uploadDocument",
        "parameters": [{ "$ref": "#/components/parameters/DatasetId" }],
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["file"], "properties": { "file": { "type": "string", "format": "binary" } } } } } },
        "responses": { "200": { "$ref": "#/components/responses/Document" }, "400": { "$ref": "#/components/responses/ValidationError" }, "413": { "$ref": "#/components/responses/PayloadTooLarge" } }
      }
    },
    "/api/v2/documents/{documentId}/reindex": {
      "post": { "tags": ["documents"], "operationId": "reindexDocument", "parameters": [{ "$ref": "#/components/parameters/DocumentId" }], "responses": { "200": { "$ref": "#/components/responses/Document" } } }
    },
    "/api/v2/documents/{documentId}/index-status": {
      "get": { "tags": ["documents"], "operationId": "getDocumentIndexStatus", "parameters": [{ "$ref": "#/components/parameters/DocumentId" }], "responses": { "200": { "$ref": "#/components/responses/IndexStatus" } } }
    },
    "/api/v2/documents/{documentId}": {
      "delete": { "tags": ["documents"], "operationId": "deleteDocument", "parameters": [{ "$ref": "#/components/parameters/DocumentId" }], "responses": { "200": { "$ref": "#/components/responses/EmptySuccess" } } }
    },
    "/api/v2/datasets/{datasetId}/documents/{documentId}/chunks": {
      "get": { "tags": ["documents"], "operationId": "listDocumentChunks", "parameters": [{ "$ref": "#/components/parameters/DatasetId" }, { "$ref": "#/components/parameters/DocumentId" }], "responses": { "200": { "$ref": "#/components/responses/ChunkList" } } }
    },
    "/api/v2/model-configs": {
      "get": { "tags": ["models"], "operationId": "listModelConfigs", "responses": { "200": { "$ref": "#/components/responses/ModelConfigList" } } },
      "post": { "tags": ["models"], "operationId": "saveModelConfig", "requestBody": { "$ref": "#/components/requestBodies/ModelConfig" }, "responses": { "200": { "$ref": "#/components/responses/ModelConfig" }, "400": { "$ref": "#/components/responses/ValidationError" } } }
    },
    "/api/v2/model-configs/{configId}/validate": {
      "post": { "tags": ["models"], "operationId": "validateModelConfig", "parameters": [{ "$ref": "#/components/parameters/ConfigId" }], "responses": { "200": { "$ref": "#/components/responses/ModelValidation" } } }
    },
    "/api/v2/model-configs/{configId}": {
      "delete": { "tags": ["models"], "operationId": "deleteModelConfig", "parameters": [{ "$ref": "#/components/parameters/ConfigId" }], "responses": { "200": { "$ref": "#/components/responses/EmptySuccess" } } }
    },
    "/api/v2/tools": {
      "get": { "tags": ["tools"], "operationId": "listTools", "parameters": [{ "name": "includeDisabled", "in": "query", "required": false, "schema": { "type": "boolean", "default": false }, "description": "ADMIN only; include disabled tools." }], "responses": { "200": { "$ref": "#/components/responses/ToolList" }, "403": { "$ref": "#/components/responses/Forbidden" } } },
      "post": { "tags": ["tools"], "operationId": "createTool", "requestBody": { "$ref": "#/components/requestBodies/Tool" }, "responses": { "200": { "$ref": "#/components/responses/Tool" }, "400": { "$ref": "#/components/responses/ValidationError" } } }
    },
    "/api/v2/tools/{toolId}": {
      "put": { "tags": ["tools"], "operationId": "updateTool", "parameters": [{ "$ref": "#/components/parameters/ToolId" }], "requestBody": { "$ref": "#/components/requestBodies/Tool" }, "responses": { "200": { "$ref": "#/components/responses/Tool" } } },
      "delete": { "tags": ["tools"], "operationId": "deleteTool", "parameters": [{ "$ref": "#/components/parameters/ToolId" }], "responses": { "200": { "$ref": "#/components/responses/EmptySuccess" } } }
    },
    "/api/v2/tools/traces": {
      "get": { "tags": ["tools"], "operationId": "listToolTraces", "responses": { "200": { "$ref": "#/components/responses/UntypedApiResponse" }, "403": { "$ref": "#/components/responses/Forbidden" } } }
    },
    "/api/v2/approvals": {
      "get": { "tags": ["tools"], "operationId": "listApprovals", "responses": { "200": { "$ref": "#/components/responses/ApprovalList" } } }
    },
    "/api/v2/approvals/{approvalId}/approve": {
      "post": { "tags": ["tools"], "operationId": "approveToolCall", "parameters": [{ "$ref": "#/components/parameters/ApprovalId" }], "requestBody": { "$ref": "#/components/requestBodies/ApprovalContinueOptional" }, "responses": { "200": { "$ref": "#/components/responses/UntypedApiResponse" } } }
    },
    "/api/v2/approvals/{approvalId}/reject": {
      "post": { "tags": ["tools"], "operationId": "rejectToolCall", "parameters": [{ "$ref": "#/components/parameters/ApprovalId" }], "requestBody": { "$ref": "#/components/requestBodies/ApprovalContinueOptional" }, "responses": { "200": { "$ref": "#/components/responses/UntypedApiResponse" } } }
