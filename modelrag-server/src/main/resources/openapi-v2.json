      "AutoQaResponse": { "allOf": [{ "$ref": "#/components/schemas/ApiResponse" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/AutoQa" } } }] },
      "AutoQa": { "type": "object", "properties": { "datasetId": { "type": "integer", "format": "int64" }, "datasetName": { "type": "string" }, "route": { "type": "string" }, "status": { "type": "string" }, "answer": { "type": "string" }, "citations": { "type": "array", "items": { "$ref": "#/components/schemas/Citation" } }, "confidence": { "type": "number" }, "refused": { "type": "boolean" }, "traceId": { "type": ["string", "null"] }, "executionId": { "type": ["string", "null"] }, "approvalId": { "type": ["string", "null"] }, "steps": { "type": "array", "items": { "type": "string" } }, "degradedComponents": { "type": "array", "items": { "type": "string" } } } },
      "Citation": { "type": "object", "required": ["chunkId", "documentId", "documentName", "location", "indexVersion", "excerpt", "score"], "properties": { "chunkId": { "type": "integer", "format": "int64" }, "documentId": { "type": "integer", "format": "int64" }, "documentName": { "type": "string" }, "location": { "type": "string", "description": "PDF 页码或结构化章节位置" }, "indexVersion": { "type": "integer", "format": "int64" }, "excerpt": { "type": "string" }, "score": { "type": "number" } } },
      "ConversationCreateRequest": { "type": "object", "properties": { "datasetId": { "type": ["integer", "null"], "format": "int64" }, "title": { "type": ["string", "null"], "maxLength": 200 } } },
      "MemoryRememberRequest": { "type": "object", "required": ["content"], "properties": { "datasetId": { "type": ["integer", "null"], "format": "int64" }, "content": { "type": "string", "minLength": 1, "maxLength": 2000 }, "type": { "type": ["string", "null"], "maxLength": 80 }, "memoryKey": { "type": ["string", "null"], "maxLength": 200 }, "confirmed": { "type": "boolean", "default": false } } },
      "MemorySettingsRequest": { "type": "object", "required": ["enabled", "retentionDays"], "properties": { "enabled": { "type": "boolean" }, "retentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 } } },
      "DatasetMutationRequest": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 200 }, "description": { "type": ["string", "null"], "maxLength": 2000 }, "chunkSize": { "type": ["integer", "null"], "minimum": 128, "maximum": 4096 }, "chunkOverlap": { "type": ["integer", "null"], "minimum": 0 }, "topK": { "type": ["integer", "null"], "minimum": 1, "maximum": 20 }, "threshold": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "similarityThreshold": { "type": ["number", "null"], "minimum": 0, "maximum": 1 } } },
      "ModelConfigRequest": { "type": "object", "required": ["modelType", "provider", "modelName"], "properties": { "modelType": { "type": "string", "minLength": 1, "maxLength": 40 }, "provider": { "type": "string", "minLength": 1, "maxLength": 120 }, "modelName": { "type": "string", "minLength": 1, "maxLength": 200 }, "baseUrl": { "type": ["string", "null"], "maxLength": 500 }, "secretId": { "type": ["string", "null"], "maxLength": 200 }, "apiKey": { "type": ["string", "null"], "maxLength": 2000, "writeOnly": true }, "enabled": { "type": "boolean" } } },
      "ToolRequest": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 }, "description": { "type": ["string", "null"] }, "riskLevel": { "type": ["string", "null"], "enum": ["LOW", "HIGH", "EXTERNAL_SIDE_EFFECT"] }, "enabled": { "type": "boolean" }, "type": { "type": ["string", "null"] }, "endpoint": { "type": ["string", "null"] }, "authHeaderName": { "type": ["string", "null"] }, "authHeaderValue": { "type": ["string", "null"], "writeOnly": true }, "jsonSchema": { "type": ["string", "null"] }, "allowedRoles": { "type": "array", "items": { "type": "string" } }, "allowedDatasetIds": { "type": "array", "items": { "type": "integer", "format": "int64" } }, "idempotent": { "type": "boolean", "default": false, "description": "允许对明确可重试错误自动重试；调用方仍须提供幂等键" } } },
      "ApprovalContinueRequest": { "type": "object", "required": ["datasetId", "question"], "properties": { "datasetId": { "type": "integer", "format": "int64", "minimum": 1 }, "question": { "type": "string", "minLength": 1 }, "conversationId": { "type": ["integer", "null"], "format": "int64" } } },
      "EvalItem": { "type": "object", "required": ["question"], "properties": { "id": { "type": ["integer", "null"], "format": "int64" }, "question": { "type": "string", "minLength": 1 }, "expectedChunkIds": { "type": "array", "items": { "type": "integer", "format": "int64" } }, "expectedAnswer": { "type": ["string", "null"] }, "shouldRefuse": { "type": "boolean" }, "category": { "type": ["string", "null"] }, "sourceTraceId": { "type": ["string", "null"] }, "failureStage": { "type": ["string", "null"] } } },
      "EvalCompareRequest": { "type": "object", "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/EvalItem" } }, "topKs": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 20 } } } },
      "IntentNode": { "type": "object", "required": ["name", "nodeType", "targetType", "priority", "enabled"], "properties": { "id": { "type": ["integer", "null"], "format": "int64" }, "datasetId": { "type": "integer", "format": "int64" }, "parentId": { "type": ["integer", "null"], "format": "int64" }, "name": { "type": "string" }, "nodeType": { "type": "string" }, "targetType": { "type": "string" }, "targetId": { "type": ["string", "null"] }, "description": { "type": ["string", "null"] }, "priority": { "type": "integer" }, "enabled": { "type": "boolean" } } },
      "MemorySettings": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "retentionDays": { "type": "integer" } } }
    }
